# Copy this file to .env and fill in the two values, then run `npm run build`.
# Both are found in the Supabase dashboard under Project Settings → API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The PUBLIC key: "anon" (legacy, starts with eyJ...) or "publishable" (sb_publishable_...).
# It is shipped to every visitor's browser; access is limited by the database policies.
# Never put the service_role / secret key here – the build refuses it.
SUPABASE_ANON_KEY=
